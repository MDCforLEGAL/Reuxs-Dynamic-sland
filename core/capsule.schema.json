{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/REPO/core/capsule.schema.json",
  "title": "ReuXs Capsule Snapshot",
  "description": "Platform independent capsule state shared by the Windows (React) and Android (Compose) clients.",
  "type": "object",
  "required": ["state", "activeModule", "timer"],
  "additionalProperties": false,
  "properties": {
    "state": {
      "type": "string",
      "enum": ["idle", "compact", "expanded", "split-bubble"]
    },
    "activeModule": {
      "type": ["string", "null"],
      "enum": ["status", "timer", "actions", "update", null]
    },
    "timer": {
      "type": "object",
      "required": ["durationMs", "remainingMs", "running"],
      "additionalProperties": false,
      "properties": {
        "durationMs": { "type": "integer", "minimum": 1000 },
        "remainingMs": { "type": "integer", "minimum": 0 },
        "running": { "type": "boolean" },
        "startedAt": { "type": ["integer", "null"] }
      }
    },
    "battery": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "notifications": { "type": "integer", "minimum": 0 },
    "updateAvailable": { "type": "boolean" },
    "updateUrl": { "type": ["string", "null"] },
    "lastUpdateCheck": { "type": ["integer", "null"] }
  },
  "allOf": [
    {
      "description": "Split bubble only exists once the capsule has been activated.",
      "if": { "properties": { "state": { "const": "split-bubble" } } },
      "then": { "properties": { "state": { "const": "split-bubble" } } }
    }
  ],
  "$defs": {
    "transitions": {
      "type": "object",
      "properties": {
        "idle": { "const": ["compact", "expanded"] },
        "compact": { "const": ["expanded", "split-bubble", "idle"] },
        "expanded": { "const": ["compact", "split-bubble", "idle"] },
        "split-bubble": { "const": ["compact", "expanded"] }
      }
    }
  }
}
